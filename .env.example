# Every variable the app and the worker read. Copy to .env.local and fill in.
# The owner creates the accounts (see docs/owner-setup.md); Claude Code only reads these.

# --- Supabase (phase 1) -------------------------------------------------------
# Local values are printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: read ONLY inside worker/. Never put it in a NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for the worker's job queue (Graphile Worker).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Sentry (phase 1, optional until the owner has a DSN) ---------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Source map upload in CI only.
SENTRY_AUTH_TOKEN=

# Makes /design-preview reachable for the visual test (local dev and CI only).
NEXT_PUBLIC_DESIGN_PREVIEW=1
